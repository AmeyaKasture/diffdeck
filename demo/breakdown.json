    {
      "id": "ttl-cache",
      "title": "Give cache entries a time-to-live",
      "group": "Core logic",
      "kind": "feature",
      "risk": "medium",
      "riskNote": "Entries are only evicted when read, so unread keys stay in memory forever.",
      "summary": "cache.set stores { value, expires } with a default 60 s TTL; cache.get deletes and misses on expired entries. fetchJson reads the cache first unless opts.noCache is set.",
      "why": "Repeated lookups of the same URL within a request burst were hitting the network every time.",
      "refs": [
        {
          "file": "src/cache.js"
        }
      ],
      "decisions": [
        {
          "question": "When are expired entries removed?",
          "chosen": {
            "label": "Lazily, on read",
            "description": "get() checks expiry and deletes stale entries.",
            "pros": [
              "No timers or background work",
              "Tiny implementation"
            ],
            "cons": [
              "Keys that are never read again leak memory",
              "No size bound"
            ]
          },
          "alternatives": [
            {
              "label": "Bounded LRU with TTL",
              "description": "Cap the number of entries and evict least-recently-used ones, keeping TTL checks.",
              "pros": [
                "Memory is bounded",
                "Hot keys stay cached"
              ],
              "cons": [
                "More code or a dependency (lru-cache)"
              ],
              "effort": "medium"
            },
            {
              "label": "Periodic sweep",
              "description": "A setInterval (unref'd) removes expired entries every minute.",
              "pros": [
                "Keeps the simple Map",
                "Bounds memory by TTL"
              ],
              "cons": [
                "Timer must be unref'd and cleaned up in tests",
                "Still unbounded within one TTL window"
              ],
              "effort": "small"
            }
          ]
        }
      ],
