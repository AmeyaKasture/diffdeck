{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diffdeck breakdown",
  "description": "An agent-written explanation of a diff: change cards, each tied to diff hunks, with the design decisions behind them.",
  "type": "object",
  "required": [
    "title",
    "summary",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "One-line name for the whole change."
    },
    "summary": {
      "type": "string",
      "description": "2-4 sentences: what the change does and why."
    },
    "reviewOrder": {
      "type": "string",
      "description": "Optional advice on which cards to read first."
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "kind",
          "risk",
          "refs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Stable kebab-case id."
          },
          "title": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "description": "Optional section name, e.g. 'Core logic', 'Tests'."
          },
          "kind": {
            "enum": [
              "feature",
              "fix",
              "refactor",
              "perf",
              "test",
              "config",
              "docs",
              "chore"
            ]
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "riskNote": {
            "type": "string",
            "description": "Why the risk is what it is."
          },
          "stale": {
            "type": "string",
            "description": "Set by diffdeck when the card's code changed since the last round. Update the card, then delete this field."
          },
          "carried": {
            "type": "integer",
            "description": "Set by diffdeck: the card's code is unchanged since this round. Leave it as is."
          },
          "summary": {
            "type": "string",
            "description": "What changed in this card, in plain words."
          },
          "why": {
            "type": "string",
            "description": "Motivation or the problem this solves."
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "file"
              ],
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string",
                  "description": "Path exactly as in diff.json."
                },
                "hunks": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "description": "Hunk indexes; omit for all hunks of the file."
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "Alternative to hunks: [start, end] new-file line range; selects overlapping hunks."
                }
              }
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "question",
                "chosen",
                "alternatives"
              ],
              "additionalProperties": false,
              "properties": {
                "question": {
                  "type": "string",
                  "description": "The design question, e.g. 'Where should retries live?'"
                },
                "chosen": {
                  "$ref": "#/$defs/option"
                },
                "alternatives": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/option"
                  }
                }
              }
            }
          },
          "flow": {
            "$ref": "#/$defs/logicFlow"
          }
        }
      }
    },
    "flow": {
      "$ref": "#/$defs/systemFlow"
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": [
        "label",
        "description",
        "pros",
        "cons"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Short name, 2-6 words."
        },
        "description": {
          "type": "string"
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effort": {
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "description": "Effort to switch to this option (alternatives only)."
        }
      }
    },
    "systemFlow": {
      "type": "object",
      "description": "Architecture / data-flow diagram of the parts of the system this change touches. Shown as the home screen.",
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "LR",
            "TB"
          ],
          "description": "LR (default) or TB."
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "Short name: module, function, service or store."
              },
              "sub": {
                "type": "string",
                "description": "Optional second line, e.g. file path or role."
              },
              "type": {
                "enum": [
                  "actor",
                  "component",
                  "service",
                  "data",
                  "external"
                ],
                "description": "actor = user/caller, component = code in this repo, service = remote API, data = store/cache/config, external = unchanged library."
              },
              "change": {
                "enum": [
                  "added",
                  "modified",
                  "removed",
                  "unchanged"
                ],
                "description": "How this element changed in the diff. Default: unchanged."
              },
              "card": {
                "type": "string",
                "description": "Card id this node opens when clicked."
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "logicFlow": {
      "type": "object",
      "description": "Flowchart of the logic this card implements, after the change.",
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "shape"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "Short step, e.g. 'Cache hit?' or 'Sleep backoff * 2^n'."
              },
              "shape": {
                "enum": [
                  "start",
                  "end",
                  "step",
                  "decision",
                  "io"
                ]
              },
              "change": {
                "enum": [
                  "added",
                  "modified",
                  "removed",
                  "unchanged"
                ],
                "description": "How this element changed in the diff. Default: unchanged."
              },
              "ref": {
                "type": "object",
                "required": [
                  "file",
                  "lines"
                ],
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "side": {
                    "enum": [
                      "new",
                      "old"
                    ],
                    "description": "old for removed code (old-file line numbers). Default new."
                  }
                },
                "description": "Code this step corresponds to; clicking the step highlights it."
              },
              "decision": {
                "type": "integer",
                "minimum": 0,
                "description": "Index into this card's decisions; clicking shows the alternatives."
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "e.g. 'yes', 'no', 'reads', 'HTTP GET'."
        },
        "change": {
          "enum": [
            "added",
            "modified",
            "removed",
            "unchanged"
          ],
          "description": "How this element changed in the diff. Default: unchanged."
        }
      }
    }
  }
}