{
  "title": "Retry transient HTTP failures and cache responses with a TTL",
  "summary": "fetchJson now retries 5xx and network errors with exponential backoff and serves repeated GETs from an in-memory cache. The cache gains per-entry expiry, and timeouts, retries and TTL move into config.json.",
  "reviewOrder": "Start with the retry loop \u2014 it changes failure behaviour for every caller \u2014 then the cache expiry it depends on.",
  "cards": [
    {
      "id": "retry-loop",
      "title": "Retry 5xx and network errors with exponential backoff",
      "group": "Core logic",
      "kind": "feature",
      "risk": "high",
      "riskNote": "Every caller of fetchJson now waits up to 200+400+800 ms before an error surfaces, and non-idempotent requests (POST) are retried too.",
      "summary": "fetchJson loops up to config.retries + 1 times. 5xx responses and thrown network/timeout errors are retried after backoffMs * 2^attempt; 4xx responses are marked fatal and rethrown immediately.",
      "why": "Upstream returns intermittent 502s under load; callers currently fail on the first blip.",
      "refs": [
        {
          "file": "src/client.js",
          "hunks": [
            0
          ]
        }
      ],
      "decisions": [
        {
          "question": "Which failures should be retried?",
          "chosen": {
            "label": "5xx and network errors",
            "description": "Retry server errors and anything thrown by fetch, including timeouts; 4xx fails immediately.",
            "pros": [
              "Covers 502/503 blips and dropped connections",
              "Client errors fail fast with no wasted latency"
            ],
            "cons": [
              "Retries POST/PATCH too, which can duplicate side effects",
              "429 Too Many Requests is not retried even though it is transient"
            ]
          },
          "alternatives": [
            {
              "label": "Idempotent methods only",
              "description": "Retry only GET/HEAD/PUT/DELETE; pass other methods through once.",
              "pros": [
                "No duplicated writes",
                "Matches HTTP semantics"
              ],
              "cons": [
                "POST callers get no resilience",
                "Needs a method check in the loop"
              ],
              "effort": "small"
            },
            {
              "label": "Retry on 429 with Retry-After",
              "description": "Also retry 429 and honour the Retry-After header for the delay.",
              "pros": [
                "Cooperates with upstream rate limits",
                "Avoids hammering a throttled server"
              ],
              "cons": [
                "Retry-After can be very long; needs a cap",
                "More branches to test"
              ],
              "effort": "small"
            }
          ]
        },
        {
          "question": "How should the delay between attempts be computed?",
          "chosen": {
            "label": "Plain exponential backoff",
            "description": "Wait backoffMs * 2^attempt (200, 400, 800 ms).",
            "pros": [
              "Simple and predictable",
              "Easy to reason about in tests"
            ],
            "cons": [
              "Clients that failed together retry together (thundering herd)",
              "Sleeps once more after the final attempt"
            ]
          },
          "alternatives": [
            {
              "label": "Exponential with full jitter",
              "description": "Wait random(0, backoffMs * 2^attempt).",
              "pros": [
                "Spreads retries from many clients",
                "Industry default (AWS guidance)"
              ],
              "cons": [
                "Non-deterministic; tests need a seeded random"
              ],
              "effort": "small"
            },
            {
              "label": "Use a library (p-retry)",
              "description": "Delegate the loop to p-retry with its built-in jitter and abort support.",
              "pros": [
                "Battle-tested edge cases",
                "Less code to own"
              ],
              "cons": [
                "New dependency",
                "Its error-classification API differs from the fatal flag"
              ],
              "effort": "medium"
            }
          ]
        }
      ],
